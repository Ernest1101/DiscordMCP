{
  "name": "discord-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude and other AI assistants control a Discord account — read channels, send messages, manage DMs.",
  "type": "module",
  "bin": {
    "discord-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('dist/index.js', '755'))\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "setup": "node scripts/setup.mjs",
    "cleanup": "node scripts/uninstall.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "claude",
    "ai"
  ],
  "author": "Ernest1101",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "discord.js-selfbot-v13": "^3.5.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
