DISCORD_TOKEN=your_discord_user_token_here

# Safety Word Filter (optional) ----------------------------------------------
# SAFETY_MODE: strict | warn | off  (default: strict)
#   strict — outgoing messages with a secret are BLOCKED; incoming are redacted
#   warn   — nothing is blocked, but detections are logged
#   off    — filter fully disabled
SAFETY_MODE=strict

# Extra literal words/strings to catch, comma-separated. Minimum 4 chars each.
# Use for your own passwords, personal API keys, internal codenames, etc.
# SAFETY_CUSTOM_WORDS=hunter2,mySecretApiKey,project-atlas-2026

# Optional path to a JSONL log file for all filter detections.
# SAFETY_LOG_FILE=C:\Users\you\AppData\Roaming\discord-mcp\safety.log
